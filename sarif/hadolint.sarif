{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "hadolint",
          "informationUri": "https://github.com/hadolint/hadolint"
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "toolExecutionNotifications": [
            {
              "level": "note",
              "message": {
                "text": "Skipped hadolint scan: no Dockerfile found at ./Dockerfile"
              }
            }
          ]
        }
      ],
      "results": [
        {
          "ruleId": "HADOLINT_SKIPPED_NO_DOCKERFILE",
          "level": "note",
          "message": {
            "text": "Skipped hadolint scan: no Dockerfile found at ./Dockerfile"
          }
        }
      ]
    }
  ]
}
