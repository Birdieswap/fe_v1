# Copy to `.env.local` and fill private values for your machine.
# Keep this project simple:
# - Do NOT set NODE_ENV manually.
# - For local dev, keep NEXT_PUBLIC_DEMO_UNSAFE=1.
# - In production (Vercel env), set NEXT_PUBLIC_DEMO_UNSAFE=0.

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_PROJECT_ID=

NEXT_PUBLIC_SEPOLIA_RPC_URL_INFURA=
NEXT_PUBLIC_SEPOLIA_RPC_URL_ALCHEMY=
NEXT_PUBLIC_BASE_RPC_URL_ALCHEMY=
NEXT_PUBLIC_BASE_RPC_URL_INFURA=
NEXT_PUBLIC_ARBITRUM_RPC_URL_ALCHEMY=
NEXT_PUBLIC_ARBITRUM_RPC_URL_INFURA=
NEXT_PUBLIC_SEPOLIA_RPC_URL_QUICKNODE=
NEXT_PUBLIC_SEPOLIA_RPC_URL_CHAINSTACK=

NEXT_PUBLIC_WALLET_ACCESS_MODE=open
NEXT_PUBLIC_LIMIT_DEPOSIT_MODE=off
NEXT_PUBLIC_ALLOWED_WALLETS=
NEXT_PUBLIC_OPERATION_MODE=product
NEXT_PUBLIC_WALLET_ALLOW_HARD_RELOAD=0
NEXT_PUBLIC_CONSENT_GET_BASE=/api/birdieswap/Consent
NEXT_PUBLIC_DEBUG=1

UPSTREAM_BASE=https://api.birdieswap.com
NEXT_PUBLIC_API_BASE=/api
NEXT_PUBLIC_DEMO_UNSAFE=1
NEXT_PUBLIC_WEB_URL=http://www.birdieswap.local:3000
NEXT_PUBLIC_APP_URL=http://app.birdieswap.local:3000

NEXT_PUBLIC_SANCTIONS_TEST_BLOCK=1
NEXT_PUBLIC_SANCTIONS_TEST_ADDRESS=

NEXT_PUBLIC_COINGECKO_DEMO_API_KEY=
CHAINALYSIS_SANCTIONS_API_KEY=
